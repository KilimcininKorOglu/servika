# Servika virtual mailboxes. This file is installed as a single Dovecot drop-in.
protocols = imap lmtp

mail_location = maildir:~/

# The stock `!include auth-system.conf.ext` in 10-auth.conf MUST be commented
# out; servika-mail-setup and the HealDovecotAuth startup repair both do it.
# Dovecot loads conf.d alphabetically, so 10-auth.conf is read BEFORE this file
# and registers `passdb { driver = pam }` first. Passdbs are tried in order, so
# every virtual mailbox login queries PAM first; the user does not exist on the
# system, pam_unix applies its failure delay, and the login takes seconds. PAM
# also lets IMAP clients guess passwords for system accounts, root included.
passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

# Authentication cache. Roundcube opens a NEW IMAP session on every HTTP
# request, so without it each request repeats the passdb query.
auth_cache_size = 10M
auth_cache_ttl = 1 hours
auth_cache_negative_ttl = 1 mins

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0660
    user = postfix
    group = postfix
  }
}

# Pigeonhole/Sieve: the panel-generated per-mailbox filters and vacation script.
protocol lmtp {
  mail_plugins = $mail_plugins sieve
}
plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_vacation_min_period = 1d
  sieve_vacation_default_period = 7d
  sieve_vacation_max_period = 30d
}

ssl_cert = </etc/ssl/servika/panel.crt
ssl_key = </etc/ssl/servika/panel.key
